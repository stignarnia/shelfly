<?xml version="1.0" encoding="utf-8"?>
<!--
  The poster frame under Material You with the pure black switch on.
  The ground goes black and the stroke stays on the wallpaper's neutral, which is what the AMOLED overlay does to the app: it moves the surfaces and leaves everything drawn on top of them alone.
-->
<shape
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:shape="rectangle"
  tools:ignore="MissingDefaultResource"
  >
  <stroke
    android:width="1dp"
    android:color="@android:color/system_neutral2_400"
    />
  <solid android:color="@color/widgetBlackBackground" />
  <corners android:radius="@dimen/mediaTileCorner" />
</shape>
