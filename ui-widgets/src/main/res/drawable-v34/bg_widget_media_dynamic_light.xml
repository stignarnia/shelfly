<?xml version="1.0" encoding="utf-8"?>
<!--
  The poster frame under Material You, light.
  The colours match @style/ThemeOverlay.Shelfly.MaterialYou in values-v34: the widget ground is the app's window background, the stroke is its placeholder ink.

  -v34 rather than a default folder because that overlay, and the surface roles it is drawn from, start at API 34 - see AppTheme.isSupported.
  Nothing below 34 can reach a dynamic palette, so nothing below 34 asks for this file.
-->
<shape
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:shape="rectangle"
>
  <stroke
    android:width="1dp"
    android:color="@android:color/system_neutral2_500"
  />
  <solid android:color="@android:color/system_neutral1_10" />
  <corners android:radius="@dimen/mediaTileCorner" />
</shape>
