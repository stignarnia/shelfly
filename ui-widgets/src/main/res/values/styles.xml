<resources>

  <!-- Widgets -->

  <!--
    Widgets do not follow the app's theme.
    They are drawn by the launcher, in its process and against its configuration, so the night mode the user picked in Shelfly has no bearing on them - and a widget that flipped to light because the launcher did would look nothing like the app beside it.
    The parent is DayNight, so every colour a widget layout reads is spelled out here rather than inherited.
  -->
  <style name="AppTheme.Widget.Dark" parent="AppTheme">
    <item name="colorWidgetBackground">#121212</item>
    <item name="android:textColorPrimary">@color/colorWhite</item>
    <item name="android:textColorSecondary">@color/colorGrayLight</item>
    <item name="colorPlaceholderIcon">#6A6A6A</item>
    <item name="colorPlaceholderStroke">#6A6A6A</item>
    <item name="colorAccent">#F44336</item>
    <item name="colorBadgeBackground">@color/colorGrayDark</item>
    <item name="colorWidgetStatusBackground">@color/colorBlackTranslucent</item>
  </style>


  <style name="WidgetItem" />

  <style name="WidgetItem.CheckButton" parent="WidgetItem">
    <item name="android:layout_width">@dimen/widgetCheckButtonWidth</item>
    <item name="android:layout_height">@dimen/widgetCheckButtonHeight</item>
    <item name="android:background">@drawable/bg_widget_check_button</item>
    <item name="android:src">@drawable/ic_check_small</item>
    <item name="android:tint">?android:attr/textColorPrimary</item>
    <item name="tint">?android:attr/textColorPrimary</item>
  </style>

  <style name="WidgetItem.Title" parent="WidgetItem">
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:ellipsize">end</item>
    <item name="android:maxLines">1</item>
    <item name="android:textColor">?android:attr/textColorPrimary</item>
    <item name="android:textSize">15sp</item>
  </style>

  <style name="WidgetItem.Subtitle" parent="WidgetItem">
    <item name="android:ellipsize">end</item>
    <item name="android:maxLines">2</item>
    <item name="android:textColor">?android:attr/textColorSecondary</item>
    <item name="android:textSize">11sp</item>
  </style>

</resources>