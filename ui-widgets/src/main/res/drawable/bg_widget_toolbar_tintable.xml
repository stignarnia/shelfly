<?xml version="1.0" encoding="utf-8"?>
<!--
  The label bar, ready to be tinted.

  Identical to bg_widget_toolbar except that its fill is opaque.
  A background tint composites SRC_IN, which multiplies the tint's alpha by the drawable's, so tinting the translucent original would come out at half the scrim it asks for.
  The scrim's own translucency lives in the palette colour instead - see widgetDarkStatusBackground.

  bg_widget_toolbar stays as it is: it is what widgets below API 31 still inflate, and those are not themed.
-->
<shape
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="rectangle"
  >
  <corners
    android:topLeftRadius="@dimen/widgetCorner"
    android:topRightRadius="@dimen/widgetCorner"
    />
  <solid android:color="@color/colorWhite" />
</shape>
