<?xml version="1.0" encoding="utf-8"?>
<!--
  The poster frame, light.
  One file per palette rather than one tinted at runtime: this shape carries two themed colours - the fill and the stroke - and a background tint would take both.
  The other widget shapes are single colour and are tinted in WidgetPalette instead.
-->
<shape
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="rectangle"
  >
  <stroke
    android:width="1dp"
    android:color="@color/widgetLightPlaceholderInk"
    />
  <solid android:color="@color/widgetLightBackground" />
  <corners android:radius="@dimen/mediaTileCorner" />
</shape>
