<manifest
  xmlns:android="http://schemas.android.com/apk/res/android">

  <application
    android:supportsRtl="true"
    android:theme="@style/AppTheme"
  >

    <receiver
      android:name="xyz.stignarnia.uiWidgets.progress.ProgressWidgetProvider"
      android:exported="true"
      android:label="Shows Progress"
    >
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>

      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/progress_widgets_provider"
      />
    </receiver>

    <receiver
      android:name="xyz.stignarnia.uiWidgets.progressMovies.ProgressMoviesWidgetProvider"
      android:exported="true"
      android:label="Movies Progress"
    >
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>

      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/progress_movies_widgets_provider"
      />
    </receiver>

    <receiver
      android:name="xyz.stignarnia.uiWidgets.calendar.CalendarWidgetProvider"
      android:exported="true"
      android:label="Shows Calendar"
    >
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>

      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/calendar_widgets_provider"
      />
    </receiver>

    <receiver
      android:name="xyz.stignarnia.uiWidgets.calendarMovies.CalendarMoviesWidgetProvider"
      android:exported="true"
      android:label="Movies Calendar"
    >
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>

      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/calendar_movies_widgets_provider"
      />
    </receiver>

    <receiver
      android:name="xyz.stignarnia.uiWidgets.search.SearchWidgetProvider"
      android:exported="true"
      android:label="Search"
    >
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>

      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/search_widgets_provider"
      />
    </receiver>

  </application>

</manifest>
