<?xml version="1.0" encoding="utf-8"?>
<!--
  Material You, dark. The light counterpart is values-v31, and the two must carry
  the same set of items - a name present in one and missing from the other falls
  through to the static theme in that mode only, which is the hardest kind of
  theming bug to spot.

  Under "Material You Dark (AMOLED)" the AMOLED overlay lands on top of this one
  and takes the backgrounds to black, leaving the wallpaper accent and text in
  place. That is why the surfaces here need no AMOLED-specific handling.
-->
<resources>

  <style name="ThemeOverlay.Shelfly.MaterialYou" parent="ThemeOverlay.Material3.DynamicColors.Dark">

    <item name="android:windowBackground">@android:color/system_neutral1_900</item>
    <item name="colorPrimaryDark">@android:color/system_neutral1_900</item>
    <item name="colorAppBackground">@android:color/system_neutral1_900</item>
    <item name="colorBackgroundChipSelected">@android:color/system_neutral1_900</item>

    <item name="colorPrimary">@android:color/system_neutral1_800</item>
    <item name="colorBottomMenuBackground">@android:color/system_neutral1_800</item>
    <item name="colorSearchViewBackground">@android:color/system_neutral1_800</item>
    <item name="colorSheetBackground">@android:color/system_neutral1_800</item>

    <item name="colorCardBackground">@android:color/system_neutral2_800</item>
    <item name="colorSearchLocalViewBackground">@android:color/system_neutral2_700</item>
    <item name="colorBadgeBackground">@android:color/system_neutral2_700</item>
    <item name="colorPlaceholderBackground">@android:color/system_neutral2_800</item>
    <item name="colorPlaceholderStroke">@android:color/system_neutral2_400</item>
    <item name="colorPlaceholderIcon">@android:color/system_neutral2_400</item>

    <item name="android:textColorPrimary">@android:color/system_neutral1_50</item>
    <item name="android:textColorSecondary">@android:color/system_neutral2_200</item>
    <item name="colorIconPrimary">@android:color/system_neutral1_50</item>
    <item name="textColorTab">@android:color/system_neutral2_300</item>
    <item name="textColorTabSelected">@android:color/system_neutral1_50</item>
    <item name="colorBottomMenuItem">@android:color/system_neutral2_300</item>
    <item name="colorBottomMenuItemChecked">@android:color/system_neutral1_50</item>
    <item name="colorSearchViewControl">@android:color/system_neutral2_200</item>
    <item name="colorSearchLocalViewControl">@android:color/system_neutral2_200</item>

    <item name="colorSeparator">@android:color/system_neutral2_700</item>
    <item name="colorBottomMenuSeparator">@android:color/system_neutral2_600</item>
    <item name="colorChipButtonStroke">@android:color/system_neutral2_600</item>
    <item name="colorProgressTrack">@android:color/system_neutral2_700</item>
    <item name="colorButtonDisabled">@android:color/system_neutral2_700</item>

    <item name="colorAccent">@android:color/system_accent1_200</item>
    <item name="colorAccentText">@android:color/system_accent1_200</item>
    <item name="colorAccentTrack">@android:color/system_accent1_700</item>
    <item name="colorTabIndicator">@android:color/system_accent1_200</item>
    <item name="textColorChipSelected">@android:color/system_accent1_200</item>
    <item name="colorBottomMenuIndicator">@android:color/system_accent2_700</item>

    <item name="colorInverseSurface">@android:color/system_neutral1_50</item>
    <item name="textColorInverseSurface">@android:color/system_neutral1_900</item>

  </style>

</resources>
