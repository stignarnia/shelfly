<resources>

  <!--
    Base app theme.

    The parent is DayNight, so light and dark are the same style resolved against two sets of values: every colour below points at colors_theme.xml, which exists in values/ (light) and values-night/ (dark).
    Nothing here should carry a literal hex or a colors.xml name unless it is deliberately fixed across themes - see the "held fixed" items further down.

    AMOLED and Material You are not separate themes; they are overlays applied on top of this one in BaseActivity.
  -->
  <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/themeBackground</item>
    <item name="switchStyle">@style/ShelflySwitch</item>
    <item name="enableEdgeToEdge">true</item>

    <item name="colorPrimary">@color/themeSurface</item>
    <item name="colorPrimaryDark">@color/themeBackground</item>
    <item name="colorAccent">@color/themeAccent</item>
    <item name="colorAppBackground">@color/themeBackground</item>

    <item name="android:textColorPrimary">@color/themeTextPrimary</item>
    <item name="android:textColorSecondary">@color/themeTextSecondary</item>
    <item name="textColorTab">@color/themeTextTertiary</item>
    <item name="textColorTabSelected">@color/themeTextPrimary</item>
    <item name="textColorChip">?android:textColorPrimary</item>
    <item name="textColorChipSelected">?attr/colorAccentText</item>
    <item name="colorBackgroundChipSelected">@color/themeBackground</item>
    <item name="colorBackgroundChipSelectedLight">?colorSearchViewBackground</item>
    <item name="colorProgressTrack">@color/themeProgressTrack</item>

    <item name="colorIconPrimary">@color/themeTextPrimary</item>
    <item name="colorTabIndicator">@color/themeAccent</item>
    <item name="colorButtonDisabled">@color/themeDisabled</item>
    <item name="colorAccentText">@color/themeAccentText</item>
    <item name="colorAccentTrack">@color/themeAccentTrack</item>

    <item name="colorInverseSurface">@color/themeInverseSurface</item>
    <item name="textColorInverseSurface">@color/themeOnInverseSurface</item>
    <item name="colorInfoSnackbar">?attr/colorInverseSurface</item>
    <item name="textColorInfoSnackbar">?attr/textColorInverseSurface</item>

    <item name="colorBottomMenuBackground">@color/themeSurface</item>
    <item name="colorBottomMenuItem">@color/themeMenuItem</item>
    <item name="colorBottomMenuItemChecked">@color/themeTextPrimary</item>
    <item name="colorBottomMenuSeparator">@color/themeMenuSeparator</item>
    <item name="colorBottomMenuIndicator">@color/themeNavIndicator</item>

    <item name="colorSearchViewBackground">@color/themeSurface</item>
    <item name="colorSearchViewStroke">@color/themeSearchStroke</item>
    <item name="colorSearchViewControl">@color/themeTextSecondary</item>

    <item name="colorSearchLocalViewBackground">@color/themeElevated</item>
    <item name="colorSearchLocalViewControl">@color/themeTextSecondary</item>

    <item name="colorPlaceholderBackground">@color/themePlaceholder</item>
    <item name="colorPlaceholderStroke">@color/themePlaceholderInk</item>
    <item name="colorPlaceholderIcon">@color/themePlaceholderInk</item>

    <item name="colorSeparator">@color/themeSeparator</item>
    <item name="colorChipButtonStroke">@color/themeStroke</item>
    <item name="colorCardBackground">@color/themeCard</item>
    <item name="colorBadgeBackground">@color/themeElevated</item>
    <item name="colorSheetBackground">@color/themeSurface</item>

    <!--
      Held fixed across every theme.

      The first is burned over poster and backdrop artwork, which is dark whatever the app is doing, so it stays white with its black shadow.
      The error snackbar is white on the brand red in both.
      The widget status scrim is read only by widgets below API 31, which are not themed and are always dark - above it the scrim comes from the widget's palette instead.
    -->
    <item name="textColorOnSurface">@color/colorWhite</item>
    <item name="colorErrorSnackbar">@color/colorError</item>
    <item name="textColorErrorSnackbar">@color/colorWhite</item>
    <item name="colorWidgetStatusBackground">@color/colorBlackTranslucent</item>
  </style>

  <!--  Bottom Sheet Dialogs -->

  <style name="CustomBottomSheetDialog" parent="@style/ThemeOverlay.Material3.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/CustomBottomSheet</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>

  <!--
    The sheet container owns its own background.
    Content layouts used to paint a rounded 16dp drawable of their own on top of it, which duplicated the shape declared below and drew the same colour twice on every sheet in the app.
  -->
  <style name="CustomBottomSheet" parent="Widget.Material3.BottomSheet">
    <item name="shapeAppearanceOverlay">@style/CustomShapeAppearanceBottomSheetDialog</item>
    <item name="backgroundTint">?attr/colorSheetBackground</item>
  </style>

  <style name="CustomShapeAppearanceBottomSheetDialog" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSizeTopRight">16dp</item>
    <item name="cornerSizeTopLeft">16dp</item>
    <item name="cornerSizeBottomRight">0dp</item>
    <item name="cornerSizeBottomLeft">0dp</item>
  </style>

  <!-- Progress Bars -->

  <style name="ProgressBar">
    <item name="android:indeterminateTintMode">src_in</item>
  </style>

  <style name="ProgressBar.Dark" parent="ProgressBar">
    <item name="android:indeterminateTint">?attr/colorSeparator</item>
  </style>

  <style name="ProgressBar.Accent" parent="ProgressBar">
    <item name="android:indeterminateTint">?attr/colorAccent</item>
    <item name="colorAccent">?attr/colorAccent</item>
  </style>

  <style name="ContentProgressBar" parent="Widget.AppCompat.ProgressBar">
    <item name="android:indeterminateTintMode">src_in</item>
  </style>

  <style name="ContentProgressBar.Dark" parent="ContentProgressBar">
    <item name="colorAccent">?attr/colorSeparator</item>
    <item name="android:indeterminateTint">?attr/colorSeparator</item>
  </style>

  <style name="ContentProgressBar.Accent" parent="ContentProgressBar">
    <item name="colorAccent">?attr/colorAccent</item>
    <item name="android:indeterminateTint">?attr/colorAccent</item>
  </style>

  <!-- Scrollbars -->

  <style name="ScrollbarsStyle">
    <item name="android:scrollbarDefaultDelayBeforeFade">200</item>
    <item name="android:scrollbarFadeDuration">100</item>
    <item name="android:scrollbarSize">@dimen/scrollBarWidth</item>
    <item name="android:scrollbarStyle">outsideOverlay</item>
    <item name="android:scrollbarThumbVertical">?attr/colorSeparator</item>
  </style>

  <!-- Modals -->

  <!--
    The dismissing half of a ModalView's button row, paired with @style/PrimaryMaterialButton for the confirm.
  -->
  <style name="ModalNegativeButton" parent="Widget.Material3.Button.TextButton.Dialog">
    <item name="android:textColor">?android:attr/textColorSecondary</item>
    <item name="cornerRadius">100dp</item>
  </style>

  <!-- Toolbar -->

  <!-- Other  -->

  <style name="ImageTitle">
    <item name="android:shadowColor">@color/colorBlack</item>
    <item name="android:shadowDx">3</item>
    <item name="android:shadowDy">3</item>
    <item name="android:shadowRadius">1</item>
    <item name="android:textColor">?attr/textColorOnSurface</item>
    <item name="android:ellipsize">end</item>
  </style>

  <style name="ScrollableTabsStyle" parent="Widget.Design.TabLayout">
    <item name="tabMode">scrollable</item>
    <item name="tabIndicatorColor">?attr/colorTabIndicator</item>
    <item name="tabPaddingStart">8dp</item>
    <item name="tabPaddingEnd">8dp</item>
    <item name="tabTextAppearance">@style/ScrollableTabTextStyle</item>
    <item name="tabSelectedTextColor">?attr/textColorTabSelected</item>
    <item name="tabIndicatorFullWidth">false</item>
    <item name="tabRippleColor">@android:color/transparent</item>
    <item name="tabIndicatorAnimationDuration">200</item>
  </style>

  <style name="ScrollableTabTextStyle" parent="TextAppearance.Design.Tab">
    <item name="android:textSize">15sp</item>
    <item name="android:textColor">?attr/textColorTab</item>
    <item name="android:layout_gravity">start</item>
    <item name="textAllCaps">false</item>
  </style>

  <style name="ScrollableTabsEpisodesStyle" parent="Widget.Design.TabLayout">
    <item name="tabMode">scrollable</item>
    <item name="tabMinWidth">0dp</item>
    <item name="tabPaddingStart">8dp</item>
    <item name="tabPaddingEnd">8dp</item>
    <item name="tabIndicatorColor">?attr/colorTabIndicator</item>
    <item name="tabTextAppearance">@style/ScrollableTabEpisodeTextStyle</item>
    <item name="tabSelectedTextColor">?attr/textColorTabSelected</item>
    <item name="tabIndicatorFullWidth">false</item>
    <item name="tabRippleColor">@android:color/transparent</item>
    <item name="tabIndicatorAnimationDuration">0</item>
  </style>

  <style name="ScrollableTabEpisodeTextStyle" parent="TextAppearance.Design.Tab">
    <item name="android:textSize">14sp</item>
    <item name="android:textColor">?attr/textColorTab</item>
    <item name="android:layout_gravity">start</item>
    <item name="textAllCaps">false</item>
  </style>

  <style name="Badge">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_gravity">top|end</item>
    <item name="android:layout_marginEnd">@dimen/spaceTiny</item>
    <item name="android:layout_marginTop">-2dp</item>
    <item name="android:visibility">gone</item>
    <item name="android:elevation">@dimen/elevationSmall</item>
    <item name="android:tint">@color/colorAccent</item>
  </style>

  <style name="Badge.Watchlist" parent="Badge">
    <item name="android:tint">@color/colorGrayLight</item>
  </style>

  <style name="CollectionItem" />

  <style name="CollectionItem.Header" parent="CollectionItem">
    <item name="android:ellipsize">end</item>
    <item name="android:gravity">start|center_vertical</item>
    <item name="android:maxLines">1</item>
    <item name="android:textAlignment">viewStart</item>
    <item name="android:textColor">?attr/colorAccentText</item>
    <item name="android:textSize">12sp</item>
  </style>

  <style name="CollectionItem.Title" parent="CollectionItem">
    <item name="android:ellipsize">end</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:gravity">start|center_vertical</item>
    <item name="android:maxLines">1</item>
    <item name="android:textAlignment">viewStart</item>
    <item name="android:textColor">?android:attr/textColorPrimary</item>
    <item name="android:textSize">18sp</item>
  </style>

  <style name="CollectionItem.Description" parent="CollectionItem">
    <item name="android:ellipsize">end</item>
    <item name="android:gravity">start|center_vertical</item>
    <item name="android:maxLines">2</item>
    <item name="android:textAlignment">viewStart</item>
    <item name="android:textColor">?android:attr/textColorSecondary</item>
    <item name="android:textSize">12sp</item>
  </style>

  <style name="ContextMenuItemButton.Move" parent="RoundTextButton">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">start|center_vertical</item>
    <item name="android:includeFontPadding">true</item>
    <item name="android:textColor">?android:attr/textColorPrimary</item>
    <item name="iconGravity">textStart</item>
    <item name="iconPadding">10dp</item>
    <item name="iconTint">?android:attr/textColorPrimary</item>
    <item name="iconSize">22dp</item>
    <item name="android:insetLeft">-16dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">15sp</item>
    <item name="rippleColor">?android:attr/textColorSecondary</item>
  </style>

  <style name="ContextMenuItemButton.Remove" parent="RoundTextButton">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">start|center_vertical</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:textColor">?android:attr/textColorPrimary</item>
    <item name="icon">@drawable/ic_remove_list</item>
    <item name="iconGravity">textStart</item>
    <item name="iconSize">22dp</item>
    <item name="android:insetLeft">-16dp</item>
    <item name="iconPadding">10dp</item>
    <item name="iconTint">?android:attr/textColorPrimary</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">15sp</item>
    <item name="rippleColor">?android:attr/textColorSecondary</item>
  </style>

  <style name="RoundMaterialButton" parent="Widget.Material3.Button">
    <item name="cornerRadius">100dp</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:letterSpacing">0.05</item>
  </style>

  <!--
    The primary call to action: a filled accent button.
    Shared by the welcome steps and every modal's confirm, so the action looks the same everywhere - define it here rather than tinting a button inline.
  -->
  <style name="PrimaryMaterialButton" parent="RoundMaterialButton">
    <item name="android:textColor">@color/selector_button_text</item>
    <item name="backgroundTint">@color/selector_primary_button_background</item>
  </style>

  <!--
    The same button in grey, for an action that belongs next to the confirm without competing with it - the WebDAV "Test connection" is the one so far.
  -->
  <style name="SecondaryMaterialButton" parent="RoundMaterialButton">
    <item name="android:textColor">@color/selector_button_text</item>
    <item name="backgroundTint">@color/selector_secondary_button_background</item>
  </style>

  <style name="RoundTextButton" parent="Widget.Material3.Button.TextButton">
    <item name="cornerRadius">100dp</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:letterSpacing">0.05</item>
  </style>

  <style name="RoundOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
    <item name="cornerRadius">100dp</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:letterSpacing">0.05</item>
  </style>

  <style name="DeclineOutlinedButton" parent="RoundOutlinedButton">
    <item name="strokeColor">?android:attr/textColorSecondary</item>
  </style>

  <style name="ShelflyBottomBar" parent="Widget.MaterialComponents.BottomNavigationView">
    <item name="itemTextAppearanceInactive">@style/ShelflyBottomBar.Text</item>
    <item name="itemTextAppearanceActive">@style/ShelflyBottomBar.Text</item>
  </style>

  <style name="ShelflyBottomBar.Text" parent="TextAppearance.Material3.LabelMedium">
    <item name="android:textSize">12sp</item>
  </style>

  <style name="ShelflyBottomBar.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
    <item name="android:color">?colorBottomMenuIndicator</item>
  </style>

  <style name="ShelflySwitch" parent="Widget.Material3.CompoundButton.Switch">
    <item name="materialThemeOverlay">@style/ShelflySwitch.Overlay</item>
  </style>

  <style name="ShelflySwitch.Overlay" parent="">
    <item name="colorPrimary">?attr/colorAccent</item>
    <item name="colorPrimaryContainer">?attr/colorAccentTrack</item>
  </style>

  <style name="ShelflyChip" parent="Widget.Material3.Chip.Suggestion">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">@dimen/chipHeight</item>
    <item name="chipMinTouchTargetSize">0dp</item>
  </style>

  <style name="ShelflyChip.Sort" parent="ShelflyChip">
    <item name="android:textColor">?android:textColorPrimary</item>
    <item name="chipBackgroundColor">?android:windowBackground</item>
    <item name="chipStrokeColor">?colorChipButtonStroke</item>
    <item name="closeIcon">@drawable/ic_arrow_alt_up</item>
    <item name="closeIconEndPadding">0dp</item>
    <item name="closeIconTint">?android:textColorPrimary</item>
    <item name="closeIconVisible">true</item>
    <item name="textStartPadding">@dimen/spaceSmall</item>
  </style>

  <style name="ShelflyChip.Filter" parent="ShelflyChip">
    <item name="android:textColor">@color/selector_chip_text</item>
    <item name="chipBackgroundColor">@color/selector_chip_background</item>
    <item name="chipStrokeColor">@color/selector_chip_stroke</item>
    <item name="closeIconVisible">false</item>
  </style>

  <style name="ShelflyChip.Button" parent="Widget.Material3.Chip.Suggestion">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">38dp</item>
    <item name="chipMinTouchTargetSize">0dp</item>
    <item name="chipBackgroundColor">?android:windowBackground</item>
    <item name="chipStrokeColor">?colorChipButtonStroke</item>
    <item name="chipIconTint">?android:textColorPrimary</item>
    <item name="chipCornerRadius">99dp</item>
    <item name="chipIconVisible">true</item>
    <item name="iconStartPadding">5dp</item>
    <item name="android:checkable">false</item>
    <item name="android:textColor">?android:textColorPrimary</item>
  </style>

  <style name="ShelflyCheckbox" parent="Widget.Material3.CompoundButton.CheckBox">
    <item name="buttonTint">@color/selector_main_checkbox</item>
    <item name="buttonIconTint">?attr/colorAppBackground</item>
    <item name="android:textColor">?android:textColorPrimary</item>
  </style>

  <style name="ShelflyCheckbox.Secondary" parent="ShelflyCheckbox">
    <item name="buttonIconTint">?attr/colorBottomMenuBackground</item>
    <item name="android:textColor">?android:textColorSecondary</item>
  </style>

  <style name="ShelflyDatePicker" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
    <item name="colorOnPrimary">?android:attr/textColorPrimary</item>
    <item name="colorSurface">?attr/colorAppBackground</item>
    <item name="colorOnSurface">?android:attr/textColorPrimary</item>
    <item name="buttonBarPositiveButtonStyle">@style/ShelflyDatePicker.Button</item>
    <item name="buttonBarNegativeButtonStyle">@style/ShelflyDatePicker.Button</item>
  </style>

  <style name="ShelflyDatePicker.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
    <item name="android:textColor">?android:textColorPrimary</item>
  </style>

  <style name="ShelflyTimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
    <item name="colorSurface">?attr/colorAppBackground</item>
    <item name="colorOnSurface">?android:attr/textColorSecondary</item>
    <item name="colorPrimary">?attr/colorBottomMenuBackground</item>
    <item name="colorOnPrimary">?android:textColorPrimary</item>
    <item name="materialClockStyle">@style/ShelflyTimePicker.Clock</item>
    <item name="materialButtonOutlinedStyle">@style/ShelflyTimePicker.Button</item>
    <item name="borderlessButtonStyle">@style/ShelflyTimePicker.Button.Positive</item>
    <item name="chipStyle">@style/ShelflyTimePicker.Chip</item>
  </style>

  <style name="ShelflyTimePicker.Clock" parent="Widget.MaterialComponents.TimePicker.Clock">
    <item name="clockHandColor">?colorAccent</item>
  </style>

  <style name="ShelflyTimePicker.Chip" parent="Widget.MaterialComponents.TimePicker.Display">
    <item name="chipBackgroundColor">@color/selector_timepicker_chip_background</item>
    <item name="android:textColor">@color/selector_timepicker_chip_text</item>
  </style>

  <style name="ShelflyTimePicker.Button" parent="Widget.MaterialComponents.TimePicker.Button">
    <item name="backgroundTint">?attr/colorAppBackground</item>
    <item name="android:textColor">@color/selector_timepicker_button_text</item>
  </style>

  <style name="ShelflyTimePicker.Button.Positive" parent="Widget.MaterialComponents.Button.TextButton">
    <item name="android:textColor">?android:textColorPrimary</item>
  </style>

</resources>
