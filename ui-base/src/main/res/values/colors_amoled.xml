<?xml version="1.0" encoding="utf-8"?>
<!--
  Surfaces for @style/ThemeOverlay.Shelfly.Amoled.

  These are the light values, and they are deliberately identical to the matching names in values/colors_theme.xml. That is what lets the AMOLED switch stay on under "Follow system": the overlay is applied whatever the mode, and by day it resolves to the ordinary light surfaces and changes nothing.
  Pure black lives in values-night/colors_amoled.xml.

  Keep these in step with colors_theme.xml - if a light surface changes there, it has to change here, or turning AMOLED on will visibly alter the light theme.
-->
<resources>

  <color name="amoledBackground">#FAFAFA</color>
  <color name="amoledSurface">#FFFFFF</color>
  <color name="amoledCard">#F2F2F2</color>
  <color name="amoledElevated">#EBEBEB</color>
  <color name="amoledPlaceholder">#EDEDED</color>

</resources>
