<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for @style/SecondaryMaterialButton: the primary button's shape in grey, for an action that sits beside the confirm without competing with it.

  Mirrors @color/selector_primary_button_background, including spelling out the disabled state rather than letting a flat tint keep it looking live.

  colorGray stays a fixed literal on purpose: it is a filled button carrying the white label from @color/selector_button_text, and a mid grey clears white in the light theme as readily as in the dark one.
  Theming it would only move it toward one of the two backgrounds it is meant to sit against.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

  <item
    android:alpha="0.3"
    android:color="@color/colorGray"
    android:state_enabled="false"
  />

  <item android:color="@color/colorGray" />

</selector>
