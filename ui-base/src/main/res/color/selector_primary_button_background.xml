<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for @style/PrimaryMaterialButton.

  Overriding backgroundTint with a flat colour would keep the filled button looking live while it is disabled, so the disabled state is spelled out here alongside the accent.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

  <item
    android:alpha="0.3"
    android:color="?attr/colorAccent"
    android:state_enabled="false"
    />

  <item android:color="?attr/colorAccent" />

</selector>
