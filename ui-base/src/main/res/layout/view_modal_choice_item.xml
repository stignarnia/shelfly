<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of setSingleChoiceItems.
  A CheckedTextView rather than a RadioButton so the whole row is the touch target, matching how the pickers behaved when they were AlertDialog list items.
-->
<CheckedTextView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/modalChoiceText"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="?attr/selectableItemBackground"
  android:checkMark="?android:attr/listChoiceIndicatorSingle"
  android:gravity="center_vertical"
  android:minHeight="48dp"
  android:paddingStart="@dimen/spaceBig"
  android:paddingEnd="@dimen/spaceBig"
  android:textColor="?android:attr/textColorPrimary"
  android:textSize="16sp"
/>
