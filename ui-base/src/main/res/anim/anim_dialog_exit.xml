<?xml version="1.0" encoding="utf-8"?>
<!--
  The tip ("?") popup leaves on a plain fade, with no counterpart to the rise.
  Dialogs do the same, so dismissing one never competes with whatever the tap
  that dismissed it opened next.
-->
<set
  xmlns:android="http://schemas.android.com/apk/res/android">
  <alpha
    android:duration="200"
    android:fromAlpha="1.0"
    android:interpolator="@android:anim/accelerate_interpolator"
    android:toAlpha="0.0"
    />
</set>
