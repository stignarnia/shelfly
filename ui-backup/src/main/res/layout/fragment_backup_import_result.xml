<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true"
  tools:background="?attr/colorAppBackground"
  tools:theme="@style/AppTheme"
>

  <com.google.android.material.appbar.AppBarLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:windowBackground"
  >

    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?android:windowBackground"
      android:elevation="@dimen/elevationNormal"
      app:contentInsetStartWithNavigation="0dp"
      app:navigationIcon="@drawable/ic_arrow_back"
      app:navigationIconTint="?android:attr/textColorPrimary"
      app:title="@string/textBackupImportResultTitle"
    />
  </com.google.android.material.appbar.AppBarLayout>

  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
  >

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="@dimen/spaceNormal"
      android:paddingTop="@dimen/spaceNormal"
      android:paddingBottom="24dp"
    >

      <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spaceSmall"
        android:contentDescription="@null"
        app:srcCompat="@drawable/ic_check_big"
        app:tint="?attr/colorAccent"
      />

      <TextView
        android:id="@+id/titleSuccess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="@string/textBackupImportResultSuccessTitle"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
      />

      <!-- Card: Movies Imported -->
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMoviesImported"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="?attr/colorCardBackground"
        app:cardCornerRadius="16dp"
        app:strokeWidth="0dp"
      >

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="@dimen/spaceNormal"
        >

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables"
          >

            <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:contentDescription="@null"
              app:srcCompat="@drawable/ic_film"
              app:tint="?attr/colorAccent"
            />

            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="12dp"
              android:text="@string/textBackupImportResultMoviesImported"
              android:textColor="?android:attr/textColorSecondary"
              android:textSize="14sp"
            />
          </LinearLayout>

          <TextView
            android:id="@+id/moviesImportedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/colorAccentText"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="142"
          />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Card: TV Shows Imported -->
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardShowsImported"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="?attr/colorCardBackground"
        app:cardCornerRadius="16dp"
        app:strokeWidth="0dp"
      >

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="@dimen/spaceNormal"
        >

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables"
          >

            <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:contentDescription="@null"
              app:srcCompat="@drawable/ic_television"
              app:tint="?attr/colorAccent"
            />

            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="12dp"
              android:text="@string/textBackupImportResultShowsImported"
              android:textColor="?android:attr/textColorSecondary"
              android:textSize="14sp"
            />
          </LinearLayout>

          <TextView
            android:id="@+id/showsImportedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/colorAccentText"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="58"
          />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Card: Movies Not Imported (Clickable) -->
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMoviesUnmatched"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/colorCardBackground"
        app:cardCornerRadius="16dp"
        app:strokeWidth="0dp"
      >

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="@dimen/spaceNormal"
        >

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
          >

            <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:contentDescription="@null"
              app:srcCompat="@drawable/ic_film"
              app:tint="?android:attr/textColorSecondary"
            />

            <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="12dp"
              android:layout_weight="1"
              android:text="@string/textBackupImportResultMoviesUnmatched"
              android:textColor="?android:attr/textColorSecondary"
              android:textSize="14sp"
            />

            <ImageView
              android:id="@+id/arrowMoviesUnmatched"
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:contentDescription="@null"
              app:srcCompat="@drawable/ic_arrow_right"
              app:tint="?android:attr/textColorSecondary"
            />
          </LinearLayout>

          <TextView
            android:id="@+id/moviesUnmatchedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="4"
          />

          <TextView
            android:id="@+id/textMoviesUnmatchedHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/textBackupImportResultTapToView"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
          />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Card: TV Shows Not Imported (Clickable) -->
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardShowsUnmatched"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/colorCardBackground"
        app:cardCornerRadius="16dp"
        app:strokeWidth="0dp"
      >

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="@dimen/spaceNormal"
        >

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
          >

            <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:contentDescription="@null"
              app:srcCompat="@drawable/ic_television"
              app:tint="?android:attr/textColorSecondary"
            />

            <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="12dp"
              android:layout_weight="1"
              android:text="@string/textBackupImportResultShowsUnmatched"
              android:textColor="?android:attr/textColorSecondary"
              android:textSize="14sp"
            />

            <ImageView
              android:id="@+id/arrowShowsUnmatched"
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:contentDescription="@null"
              app:srcCompat="@drawable/ic_arrow_right"
              app:tint="?android:attr/textColorSecondary"
            />
          </LinearLayout>

          <TextView
            android:id="@+id/showsUnmatchedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="1"
          />

          <TextView
            android:id="@+id/textShowsUnmatchedHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/textBackupImportResultTapToView"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
          />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Ratings disclaimer -->
      <LinearLayout
        android:id="@+id/ratingsDisclaimerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:ignore="UseCompoundDrawables"
      >

        <ImageView
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:contentDescription="@null"
          app:srcCompat="@drawable/ic_info"
          app:tint="?android:attr/textColorSecondary"
        />

        <TextView
          android:id="@+id/textRatingsDisclaimer"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:text="@string/textBackupImportRatingsDisclaimer"
          android:textColor="?android:attr/textColorSecondary"
          android:textSize="12sp"
        />
      </LinearLayout>

      <!-- Done Button -->
      <com.google.android.material.button.MaterialButton
        android:id="@+id/doneButton"
        style="@style/RoundMaterialButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/textBackupImportResultDone"
        android:textColor="?attr/textColorOnSurface"
        app:backgroundTint="?attr/colorAccent"
        app:rippleColor="?android:attr/textColorPrimary"
      />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
