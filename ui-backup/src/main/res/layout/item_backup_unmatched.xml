<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginHorizontal="@dimen/spaceNormal"
  android:layout_marginVertical="6dp"
  android:foreground="?attr/selectableItemBackground"
  app:cardBackgroundColor="?attr/colorCardBackground"
  app:cardCornerRadius="12dp"
  app:strokeWidth="0dp"
>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spaceNormal"
  >

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical"
    >

      <TextView
        android:id="@+id/unmatchedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Breaking Bad"
      />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="top"
        android:orientation="horizontal"
        tools:ignore="UseCompoundDrawables"
      >

        <ImageView
          android:id="@+id/unmatchedIcon"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:layout_marginTop="2dp"
          android:contentDescription="@null"
          app:srcCompat="@drawable/ic_info"
          app:tint="?android:attr/textColorSecondary"
        />

        <TextView
          android:id="@+id/unmatchedReason"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:textColor="?android:attr/textColorSecondary"
          android:textSize="13sp"
          tools:text="No exact title match on TMDB."
        />
      </LinearLayout>
    </LinearLayout>

    <ImageView
      android:id="@+id/unmatchedArrow"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_marginStart="12dp"
      android:contentDescription="@null"
      android:visibility="gone"
      app:srcCompat="@drawable/ic_arrow_right"
      app:tint="?android:attr/textColorSecondary"
      tools:visibility="visible"
    />
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
