<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:paddingStart="@dimen/spaceNormal"
  android:paddingTop="@dimen/spaceSmall"
  android:paddingEnd="@dimen/spaceNormal"
>

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/deviceNameInputLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/textSettingsBackupDeviceNameHint"
    app:boxStrokeColor="@color/selector_text_input"
    app:endIconMode="clear_text"
    app:hintTextColor="@color/selector_text_input"
  >

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/deviceNameInput"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="textCapWords"
      android:maxLength="32"
      android:maxLines="1"
    />

  </com.google.android.material.textfield.TextInputLayout>

</FrameLayout>
