<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="@dimen/spaceNormal"
  android:paddingTop="@dimen/spaceSmall"
  android:paddingEnd="@dimen/spaceNormal"
>

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/webdavUrlInputLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/textSettingsWebDavUrlHint"
    app:boxStrokeColor="@color/selector_text_input"
    app:endIconMode="clear_text"
    app:hintTextColor="@color/selector_text_input"
  >

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/webdavUrlInput"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="textUri|textNoSuggestions"
      android:maxLines="1"
    />

  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/webdavUsernameInputLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spaceSmall"
    android:hint="@string/textSettingsWebDavUsernameHint"
    app:boxStrokeColor="@color/selector_text_input"
    app:endIconMode="clear_text"
    app:hintTextColor="@color/selector_text_input"
  >

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/webdavUsernameInput"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="textNoSuggestions"
      android:maxLines="1"
    />

  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/webdavPasswordInputLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spaceSmall"
    android:hint="@string/textSettingsWebDavPasswordHint"
    app:boxStrokeColor="@color/selector_text_input"
    app:endIconMode="password_toggle"
    app:hintTextColor="@color/selector_text_input"
  >

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/webdavPasswordInput"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="textPassword"
      android:maxLines="1"
    />

  </com.google.android.material.textfield.TextInputLayout>

  <!--
    Always present, always three lines tall.
    The longest outcome ("Could not establish a secure connection...") wraps to three, so holding that height from the start means running a test writes into a box that is already there instead of growing the modal under the user's finger.
  -->
  <TextView
    android:id="@+id/webdavTestResult"
    style="@style/Settings.Summary"
    android:layout_width="match_parent"
    android:layout_marginTop="@dimen/spaceSmall"
    android:lines="3"
    tools:text="Connected. The folder is reachable and writable."
    xmlns:tools="http://schemas.android.com/tools"
  />

</LinearLayout>
