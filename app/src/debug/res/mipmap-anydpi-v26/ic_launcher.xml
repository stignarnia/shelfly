<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the launcher icon in main for debug builds only, so an installed debug build is distinguishable from a release one at a glance.
  The foreground is the grey artwork in this source set; the background colour and the monochrome silhouette are shared with main.
-->
<adaptive-icon
  xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background" />
  <foreground android:drawable="@drawable/ic_launcher_foreground" />
  <monochrome android:drawable="@drawable/ic_launcher_mono" />
</adaptive-icon>
