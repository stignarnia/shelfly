<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
>

  <TextView
    android:id="@+id/viewWelcomeStepApiKeyTitle"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="@string/textOnboardingApiKeyTitle"
    android:textColor="?android:attr/textColorPrimary"
    android:textSize="20sp"
    android:textStyle="bold"
    android:labelFor="@+id/viewWelcomeStepApiKeyInput"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
  />

  <TextView
    android:id="@+id/viewWelcomeStepApiKeyMessage"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spaceNormal"
    android:autoLink="web"
    android:textColor="?android:attr/textColorPrimary"
    android:textColorLink="?attr/colorAccentText"
    android:textSize="15sp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/viewWelcomeStepApiKeyTitle"
  />

  <EditText
    android:id="@+id/viewWelcomeStepApiKeyInput"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spaceNormal"
    android:autofillHints="password"
    android:inputType="text"
    android:maxLines="1"
    android:textColor="?android:attr/textColorPrimary"
    android:textColorHint="?android:attr/textColorSecondary"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/viewWelcomeStepApiKeyMessage"
  />

</androidx.constraintlayout.widget.ConstraintLayout>
