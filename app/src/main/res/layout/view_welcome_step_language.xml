<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  >

  <ImageView
    android:id="@+id/viewWelcomeStepLanguageIcon"
    android:layout_width="100dp"
    android:layout_height="100dp"
    android:importantForAccessibility="no"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:srcCompat="@drawable/ic_languages"
    />

  <TextView
    android:id="@+id/viewWelcomeStepLanguageMessage"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spaceBig"
    android:layout_marginBottom="@dimen/spaceSmall"
    android:textColor="?android:attr/textColorPrimary"
    android:textSize="16sp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/viewWelcomeStepLanguageIcon"
    tools:text="@tools:sample/lorem/random"
    />

  <TextView
    android:id="@+id/viewWelcomeStepLanguageHint"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:textColor="?android:attr/textColorSecondary"
    android:textSize="12sp"
    android:textStyle="italic"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/viewWelcomeStepLanguageMessage"
    />

</androidx.constraintlayout.widget.ConstraintLayout>
