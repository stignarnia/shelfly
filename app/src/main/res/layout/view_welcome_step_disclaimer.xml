<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  >

  <TextView
    android:id="@+id/viewWelcomeStepDisclaimerTitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textColor="?android:attr/textColorPrimary"
    android:textSize="28sp"
    android:textStyle="bold"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    />

  <ImageView
    android:id="@+id/viewWelcomeStepDisclaimerIcon"
    android:layout_width="80dp"
    android:layout_height="80dp"
    android:layout_margin="@dimen/spaceBig"
    android:importantForAccessibility="no"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/viewWelcomeStepDisclaimerTitle"
    app:srcCompat="@drawable/ic_eye_off"
    />

  <TextView
    android:id="@+id/viewWelcomeStepDisclaimerMessage"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:textColor="?android:attr/textColorPrimary"
    android:textSize="15sp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/viewWelcomeStepDisclaimerIcon"
    />

</androidx.constraintlayout.widget.ConstraintLayout>
